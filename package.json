{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"verify": "npm run check && npm run lint && npm run build && node scripts/verify-build.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@opentelemetry/api": "^1.9.1",
		"@shikijs/transformers": "^4.5.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.0.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-katex": "^7.0.1",
		"remark-math": "^3.0.1",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.1.1",
		"@fontsource/jetbrains-mono": "^5.1.2",
		"@lucide/svelte": "^1.58.0",
		"katex": "^0.19.0",
		"open-props": "^1.7.12",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"katex": "$katex"
	}
}
