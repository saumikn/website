{
	"extends": "$app/tsconfig",
	"include": ["src", "*.ts", "*.js"],
	"exclude": ["node_modules", "src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["$app/types", "node"]
	}
}
